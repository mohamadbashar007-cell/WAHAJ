# Public form endpoint from your activated form service (Formspree/Basin/etc.).
# Build-time public values; never put secret API keys in VITE_ variables.
VITE_FORM_ENDPOINT=
VITE_CONTACT_EMAIL=
# International digits only, for example 201000000000. Use your verified number.
VITE_WHATSAPP_NUMBER=
VITE_INSTAGRAM_URL=
VITE_BEHANCE_URL=
